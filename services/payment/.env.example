# Server Configuration
PORT=3006
SERVICE_NAME=payment-service
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://mongo:27017/eduelderly-payment

# Inter-service URLs
ENROLLMENT_SERVICE_URL=http://enrollment:3004

# Internal Service Key (shared across all services)
INTERNAL_SERVICE_KEY=dev_internal_key_987654321

# Mock checkout URL shown to learners after paid enroll (informational)
MOCK_CHECKOUT_BASE_URL=http://localhost:5173/#order-pending

# Payment provider: mock | razorpay | none
# mock (default outside production): fake checkout URL, HMAC-signed fake webhooks,
#   and learner self-confirm from the checkout page.
# razorpay: real Orders API + webhooks (set the RAZORPAY_* keys below).
# none (default in production when unset): checkout refused until a provider is configured.
PAYMENT_PROVIDER=mock
MOCK_WEBHOOK_SECRET=mock-webhook-secret

# Razorpay (only when PAYMENT_PROVIDER=razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Frontend base URL used to build provider checkout return pages
APP_URL=http://localhost:5173
