# Server Configuration
PORT=3004
SERVICE_NAME=enrollment-service
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://mongo:27017/eduelderly-enrollment

# Inter-service URLs
COURSE_SERVICE_URL=http://course:3003
USER_SERVICE_URL=http://user:3002
PAYMENT_SERVICE_URL=http://payment:3006
NOTIFICATION_SERVICE_URL=http://notification:3007
CERTIFICATE_SERVICE_URL=http://certificate:3009

# Internal Service Key (shared across all services)
INTERNAL_SERVICE_KEY=dev_internal_key_987654321
# Distinct from INTERNAL_SERVICE_KEY: proves a request came via the gateway.
# The gateway never holds INTERNAL_SERVICE_KEY, so it cannot reach /internal routes.
GATEWAY_KEY=dev_gateway_key_change_in_production_123456789
