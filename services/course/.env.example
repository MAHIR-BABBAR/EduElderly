# Server Configuration
PORT=3003
SERVICE_NAME=course-service
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://mongo:27017/eduelderly-course

# Internal Service Key (shared across all services — required for /internal/* routes)
INTERNAL_SERVICE_KEY=dev_internal_key_987654321
# Distinct from INTERNAL_SERVICE_KEY: proves a request came via the gateway.
# The gateway never holds INTERNAL_SERVICE_KEY, so it cannot reach /internal routes.
GATEWAY_KEY=dev_gateway_key_change_in_production_123456789

# --- Post-MVP: private media upload (not used in MVP; topics use pasted URLs) ---
# CLOUDINARY_CLOUD_NAME=
# AWS_S3_BUCKET=

# Optional Redis read-through cache for the public catalog (X-Cache: HIT|MISS)
REDIS_URL=redis://redis:6379
CATALOG_CACHE_TTL_SECONDS=60
