# Server Configuration
PORT=3009
SERVICE_NAME=certificate-service
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://mongo:27017/eduelderly-certificate

# PDF storage: local (filesystem, default) | none (regenerate on every download)
CERT_STORAGE=local
CERT_STORAGE_DIR=./storage

# Async PDF rendering (optional). With REDIS_URL set, PDFs are pre-rendered by a
# BullMQ worker with retries; downloads fall back to on-demand rendering.
REDIS_URL=redis://redis:6379
QUEUE_ENABLED=true

# Public frontend URL for verify links
APP_URL=http://localhost:5173

# Internal Service Key (shared across all services)
INTERNAL_SERVICE_KEY=dev_internal_key_987654321
