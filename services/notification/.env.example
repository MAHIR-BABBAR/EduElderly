# Server Configuration
PORT=3007
SERVICE_NAME=notification-service
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://mongo:27017/eduelderly-notification

# Brevo transactional email
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=EduElderly

# Internal Service Key (shared across all services)
INTERNAL_SERVICE_KEY=dev_internal_key_987654321
# Distinct from INTERNAL_SERVICE_KEY: proves a request came via the gateway.
# The gateway never holds INTERNAL_SERVICE_KEY, so it cannot reach /internal routes.
GATEWAY_KEY=dev_gateway_key_change_in_production_123456789

# Async delivery (optional). When REDIS_URL is set, emails are queued in BullMQ
# and delivered by a worker with 5 retries and exponential backoff.
# Without it, emails are sent inline. Set QUEUE_ENABLED=false to force inline.
REDIS_URL=redis://redis:6379
QUEUE_ENABLED=true
