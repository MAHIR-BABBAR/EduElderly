# API base — leave empty to use Vite proxy (/api → gateway :8080)
VITE_API_BASE_URL=

# Where the Vite dev proxy forwards /api. Only needed when the gateway is not
# on 8080 — e.g. `GATEWAY_HOST_PORT=8081 docker compose up -d` because another
# program (some backup agents do) squats on 8080. Set it in your shell, not
# here, if you prefer: VITE_GATEWAY_URL=http://localhost:8081 npm run dev
# VITE_GATEWAY_URL=http://localhost:8080
