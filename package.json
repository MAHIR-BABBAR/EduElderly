{
  "name": "eduelderly-root",
  "version": "1.0.0",
  "description": "Initial release - EduElderly Platform",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "docker compose up --build",
    "dev:gateway": "cd services/gateway && npm run dev",
    "test": "npm run test --workspaces --if-present",
    "reseed": "node scripts/reseed-databases.js",
    "demo:seed": "node scripts/reseed-databases.js",
    "lint": "eslint .",
    "format": "prettier --write '**/*.{js,jsx,json}'",
    "dev:client": "npm run dev --workspace=@eduelderly/client",
    "docs:validate": "node scripts/validate-openapi.js",
    "docs:export": "node scripts/validate-openapi.js --export"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0"
  }
}
