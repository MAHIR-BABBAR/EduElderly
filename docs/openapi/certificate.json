{
  "openapi": "3.0.3",
  "info": {
    "title": "EduElderly Certificate Service",
    "version": "1.0.0",
    "description": "Issues one certificate per learner and course when the enrollment service reports completion. Certificates are publicly verifiable by id without authentication.",
    "license": {
      "name": "ISC"
    }
  },
  "servers": [
    {
      "url": "/api/v1/certificates",
      "description": "Through the API gateway"
    }
  ],
  "tags": [
    {
      "name": "Certificates",
      "description": "My certificates"
    },
    {
      "name": "Verify",
      "description": "Public verification"
    },
    {
      "name": "Internal",
      "description": "Service-to-service endpoints. Require the shared `X-Service-Key`; not routed by the gateway."
    }
  ],
  "paths": {
    "/me": {
      "get": {
        "tags": [
          "Certificates"
        ],
        "summary": "List my certificates",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Certificate"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/me/{certId}/download": {
      "get": {
        "tags": [
          "Certificates"
        ],
        "summary": "Download my certificate PDF",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "certId",
            "in": "path",
            "required": true,
            "description": "Certificate id",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "PDF bytes",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/{certId}/verify": {
      "get": {
        "tags": [
          "Verify"
        ],
        "summary": "Verify a certificate by id (public)",
        "security": [],
        "parameters": [
          {
            "name": "certId",
            "in": "path",
            "required": true,
            "description": "Certificate id",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "`valid: false` when the id is unknown",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "$ref": "#/components/schemas/Verification"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/internal/issue": {
      "post": {
        "tags": [
          "Internal"
        ],
        "summary": "Issue a certificate (idempotent per user and course)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "userId",
                  "courseId",
                  "userName",
                  "courseTitle"
                ],
                "properties": {
                  "userId": {
                    "type": "string"
                  },
                  "courseId": {
                    "type": "string"
                  },
                  "userName": {
                    "type": "string"
                  },
                  "courseTitle": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "certId": {
                          "type": "string"
                        },
                        "verifyUrl": {
                          "type": "string",
                          "format": "uri"
                        },
                        "issuedAt": {
                          "type": "string",
                          "format": "date-time",
                          "example": "2026-09-13T10:00:00.000Z"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          }
        },
        "servers": [
          {
            "url": "http://certificate:3009",
            "description": "Docker network only (not via gateway)"
          }
        ],
        "security": [
          {
            "serviceKey": []
          }
        ]
      }
    },
    "/internal/stats": {
      "get": {
        "tags": [
          "Internal"
        ],
        "summary": "Certificate count for the admin dashboard",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "totalCertificates": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "servers": [
          {
            "url": "http://certificate:3009",
            "description": "Docker network only (not via gateway)"
          }
        ],
        "security": [
          {
            "serviceKey": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Access token from `POST /api/v1/auth/login`. The gateway validates it and forwards `X-User-Id` / `X-User-Role` to services."
      },
      "serviceKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Service-Key",
        "description": "Shared secret (`INTERNAL_SERVICE_KEY`) injected by the gateway or another service."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "success",
          "statusCode",
          "message"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "statusCode": {
            "type": "integer",
            "example": 404
          },
          "code": {
            "type": "string",
            "nullable": true,
            "description": "Machine-readable error code from @eduelderly/shared ERROR_CODES",
            "example": "E_NOT_FOUND"
          },
          "message": {
            "type": "string",
            "example": "Enrollment not found"
          }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "example": 1
          },
          "limit": {
            "type": "integer",
            "example": 20
          },
          "total": {
            "type": "integer",
            "example": 42
          },
          "totalPages": {
            "type": "integer",
            "example": 3
          }
        }
      },
      "Certificate": {
        "type": "object",
        "properties": {
          "certId": {
            "type": "string",
            "format": "uuid",
            "example": "0192b1d2-0000-7a1b-9f2e-000000000091"
          },
          "userId": {
            "type": "string"
          },
          "courseId": {
            "type": "string"
          },
          "courseTitle": {
            "type": "string",
            "example": "Email Basics for Everyday Life"
          },
          "userName": {
            "type": "string",
            "example": "Margaret Rose"
          },
          "issuedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-09-13T10:00:00.000Z"
          },
          "verifyUrl": {
            "type": "string",
            "format": "uri",
            "example": "http://localhost:5173/verify-certificate?certId=0192b1d2-…"
          }
        }
      },
      "Verification": {
        "type": "object",
        "properties": {
          "valid": {
            "type": "boolean"
          },
          "certId": {
            "type": "string"
          },
          "courseTitle": {
            "type": "string"
          },
          "userName": {
            "type": "string"
          },
          "issuedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-09-13T10:00:00.000Z"
          }
        }
      }
    },
    "responses": {
      "ValidationError": {
        "description": "Request failed validation",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "success": false,
              "statusCode": 400,
              "code": "E_VALIDATION",
              "message": "courseId is required"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid credentials",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "success": false,
              "statusCode": 401,
              "code": "E_AUTH_INVALID",
              "message": "No token provided"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Authenticated but not allowed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "success": false,
              "statusCode": 403,
              "code": "E_FORBIDDEN",
              "message": "Admin access required"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "success": false,
              "statusCode": 404,
              "code": "E_NOT_FOUND",
              "message": "Enrollment not found"
            }
          }
        }
      },
      "Conflict": {
        "description": "State conflict",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "success": false,
              "statusCode": 409,
              "code": "E_ALREADY_ENROLLED",
              "message": "Already enrolled in this course"
            }
          }
        }
      },
      "RateLimited": {
        "description": "Too many requests",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "success": false,
              "statusCode": 429,
              "code": "E_RATE_LIMIT",
              "message": "Too many requests, please try again later"
            }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "A downstream dependency is unavailable",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "success": false,
              "statusCode": 503,
              "code": "E_SERVICE_UNAVAILABLE",
              "message": "The requested service is temporarily unavailable"
            }
          }
        }
      }
    }
  }
}
